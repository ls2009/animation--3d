# Sinaa Motion Lab — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# All values are read from the environment; nothing is hardcoded.

# Anthropic API key — used only by apps/api (server-side). The browser never sees it.
ANTHROPIC_API_KEY=

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Languages the golden set runs in (comma-separated ISO codes)
GOLDEN_LANGUAGES=en,fr,ar
