# Sinaa Motion Lab — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# All values are read from the environment; nothing is hardcoded.

# Anthropic API key — used only by apps/api (server-side). The browser never sees it.
# SINAA_ANTHROPIC_KEY is read first and exists because some managed cloud
# environments reserve the ANTHROPIC_API_KEY name and strip it; either works.
ANTHROPIC_API_KEY=
# SINAA_ANTHROPIC_KEY=

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Languages the golden set runs in (comma-separated ISO codes)
GOLDEN_LANGUAGES=en,fr,ar

# Production extras (platform secret stores, not this file):
# ALLOWED_ORIGINS=https://your-web-domain   # CORS for apps/api; default * in dev
# PIPELINE=single                           # or: crew
# VOYAGE_API_KEY=                           # optional: Director exemplar embeddings
