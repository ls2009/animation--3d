{
  "name": "sinaa-motion-lab",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "keyframes": "pnpm --filter @sinaa/headless run keyframes",
    "golden:run": "uv --directory apps/api run python -m pipeline.golden"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "gl"]
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
